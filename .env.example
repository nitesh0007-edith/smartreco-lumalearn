# Required for all AI calls. Create an rsk_... key at https://app.meshapi.ai
MESH_API_KEY=

# Replace in every non-local environment.
SECRET_KEY=replace-with-a-long-random-value
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/smartreco.db
CHROMA_PATH=./data/chroma

# Optional comma-separated SHA-256 digests of normalized administrator emails.
ADMIN_EMAIL_HASHES=

# Mesh models (both are invoked only through https://api.meshapi.ai/v1)
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# Agent efficiency controls
RECOMMENDATION_EVENT_THRESHOLD=5
RECOMMENDATION_COOLDOWN_MINUTES=10
AGENT_RETRY_COOLDOWN_SECONDS=120

# Optional scheduled email delivery
SCHEDULER_ENABLED=true
DIGEST_HOUR_UTC=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
